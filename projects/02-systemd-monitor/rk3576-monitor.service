[Unit]
Description=RK3576 System Monitor (course lab)

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=/usr/bin/bash @PROJECT_DIR@/rk3576-monitor.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
